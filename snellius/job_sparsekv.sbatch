#!/usr/bin/env bash
#SBATCH --job-name=sparsekv
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=05:00:00
#SBATCH --output=sparsekv-%j.out
# exp60: a KV-sparse copy (target weights or 4-bit, attending to sinks + window + top-k of the shared target cache)
# as the feature source for the refresh at 2K .. 32K context. Reports tau, copy agreement, feature cosine and the
# share of the cache read, against the full-cache copies. Needs no training data; builds long contexts from
# multi-turn history generated by the target itself.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
module purge
module load 2024 2>/dev/null && module load Python/3.12.3-GCCcore-13.3.0 2>/dev/null \
  || { module load 2023 && module load Python/3.11.3-GCCcore-12.3.0; }
source "${HSPEC_VENV:-$HOME/venvs/hspec}/bin/activate"
export HF_HOME=${HF_HOME:-/scratch-shared/$USER/hf}
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HSPEC_RESULTS="$SLURM_SUBMIT_DIR/results/sparsekv"
mkdir -p "$HSPEC_RESULTS"
F="grep --line-buffered -v -i warn"
python scripts/exp60_sparsekv.py --copies target bnb4:Qwen/Qwen3-8B --ctx 2048 8192 16384 32768 \
  --budgets 256 1024 4096 --n 6 --anchors 16 --out exp60_sparsekv 2>&1 | $F
