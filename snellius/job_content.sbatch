#!/usr/bin/env bash
#SBATCH --job-name=content
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:30:00
#SBATCH --output=content-%j.out
# exp115: what the target's hidden states hold at each depth, by how many tokens ahead (linear readout of the token
# at p + j from layer l at position p). Uses the sequences generated by job_taps.sbatch for the same TAG.
#   TARGET, DRAFT (HF ids), TAG; PAST=1 reads backwards (tokens p - k) instead of forwards (p + j);
#   ANCHOR=1 reads forwards with the token p + 1 given
# Standard pairs: bash snellius/submit_content.sh
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
module purge
module load 2024 2>/dev/null && module load Python/3.12.3-GCCcore-13.3.0 2>/dev/null \
  || { module load 2023 && module load Python/3.11.3-GCCcore-12.3.0; }
source "${HSPEC_VENV:-$HOME/venvs/hspec}/bin/activate"
export HF_HOME=${HF_HOME:-/scratch-shared/$USER/hf}
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export HSPEC_RESULTS="$SLURM_SUBMIT_DIR/results/taps"
F="grep --line-buffered -v -i warn"
D=${TAPS_DIR:-/scratch-shared/$USER/hspec_taps}/$TAG
[ -f "$D/shard0.pt" ] || { echo "[content] no data in $D (run job_taps.sbatch for this TAG first)"; exit 1; }
if [ "${ANCHOR:-0}" = 1 ]; then
  python scripts/exp115_tap_content.py --target "$TARGET" --draft "$DRAFT" --data "$D" --anchor --save content_anchor_$TAG 2>&1 | $F
elif [ "${PAST:-0}" = 1 ]; then
  python scripts/exp115_tap_content.py --target "$TARGET" --draft "$DRAFT" --data "$D" --past --save content_past_$TAG 2>&1 | $F
else
  python scripts/exp115_tap_content.py --target "$TARGET" --draft "$DRAFT" --data "$D" --save content_$TAG 2>&1 | $F
fi
