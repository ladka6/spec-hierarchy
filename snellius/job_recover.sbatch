#!/usr/bin/env bash
#SBATCH --job-name=recover
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=05:00:00
#SBATCH --output=recover-%j.out
# Can a drafter be re-aligned cheaply to a fine-tuned target, and does it forget the base?
#   sbatch snellius/job_recover.sbatch NAME DOMAIN STEPS
# 1) the fine-tuned target (made if missing), 2) 2k prompts of training data generated by it,
# 3) the base drafter fine-tuned on that data (1 epoch), 4) speed on the fine-tuned target
# and 5) on the base target with the re-aligned drafter (forgetting).
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
NAME=$1; DOMAIN=$2; STEPS=$3
module purge
module load 2024 2>/dev/null && module load Python/3.12.3-GCCcore-13.3.0 2>/dev/null \
  || { module load 2023 && module load Python/3.11.3-GCCcore-12.3.0; }
source "${HSPEC_VENV:-$HOME/venvs/hspec}/bin/activate"
export HF_HOME=${HF_HOME:-/scratch-shared/$USER/hf}
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
W=${DRIFT_DIR:-/scratch-shared/$USER/hspec_drift}
export HSPEC_RESULTS="$SLURM_SUBMIT_DIR/results/drift"
F="grep --line-buffered -v -i warn"
BASE=Qwen/Qwen3-8B
DRAFT0=z-lab/Qwen3-8B-DFlash-b16
VAR="$W/qwen3-8b-$NAME"
mkdir -p "$W" "$HSPEC_RESULTS"

[ -f "$VAR/config.json" ] || python scripts/lora_target.py --domain $DOMAIN --steps $STEPS --out "$VAR" 2>&1 | $F
[ -f "$W/data_$NAME/shard0.pt" ] || python scripts/gen_traindata.py --target "$VAR" --max-prompts 2000 \
  --out "$W/data_$NAME" 2>&1 | $F
[ -f "$W/drafter_$NAME/config.json" ] || python scripts/train_lag.py --target "$VAR" --draft $DRAFT0 \
  --data "$W/data_$NAME" --out "$W/drafter_$NAME" --max-lag 0 --epochs 1 --val-seqs 32 2>&1 | $F
# speed on the fine-tuned target: before (base drafter) is in the drift run; after:
[ -f "$HSPEC_RESULTS/exp21_$NAME.json" ] || python scripts/exp21_drift.py --variant "$VAR" --name $NAME --n 10 2>&1 | $F
python scripts/exp21_drift.py --variant "$VAR" --draft "$W/drafter_$NAME" --name "$NAME+realigned" --n 10 2>&1 | $F
# forgetting: the re-aligned drafter back on the base target
python scripts/exp21_drift.py --variant $BASE --draft "$W/drafter_$NAME" --name "base+drafter_$NAME" --n 10 2>&1 | $F
